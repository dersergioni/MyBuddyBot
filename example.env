# Required
TG_API_TOKEN=your-telegram-token
MYBUDDYBOT_DB_PATH=./mybuddybot.db

# Required: set at least one AI provider token
OAI_API_TOKEN=your-openai-key
XAI_API_TOKEN=your-xai-key
GOOGLE_API_TOKEN=your-google-key

# Optional: runtime
MYBUDDYBOT_NAME=MyBuddyBot
MYBUDDYBOT_DEFAULT_PROVIDER=openai
MYBUDDYBOT_STATE_PATH=./MyBuddyBotState.bin
MYBUDDYBOT_WORKER_THREADS=4
MYBUDDYBOT_DEBUG_LEVEL_MODE=1

# Optional: access control (CSV)
MYBUDDYBOT_ALLOWLIST_IDS=
MYBUDDYBOT_ALLOWLIST_USERNAMES=
MYBUDDYBOT_BLOCKLIST_IDS=
MYBUDDYBOT_BLOCKLIST_USERNAMES=
MYBUDDYBOT_ADMIN_IDS=

# Optional: tests
MYBUDDYBOT_RUN_INTEGRATION_TESTS=
